@model Usuario

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_LayoutExterno";
}

<section class="text-center text-lg-start">
    <!-- Jumbotron -->
    <div class="login-section">
        <div class="container login-container">
            <div class="row g-0 align-items-center">
                <div class="col-lg-6 mb-5 mb-lg-0">
                    <img src="~/img/login.png" class="w-100 rounded-4 shadow-4" />
                </div>
                <div class="col-lg-5 mb-5 mb-lg-0">
                    <div class="card cascading-left bg-body-tertiary" style="backdrop-filter: blur(30px);">
                        <div class="card-body p-4 shadow-5 text-center">
                            <iconify-icon icon="mdi:paw" class="login-icon"></iconify-icon>
                            <h2 class="fw-bold mb-3">Bienvenido de Vuelta</h2>
                            <p class="text-muted mb-4">Inicia sesión para conectar con las mascotas</p>

                            @if (ViewBag.Mensaje != null)
                            {
                                <div class="alert alert-danger text-center text-black">
                                    @ViewBag.Mensaje
                                </div>
                            }
                        
                            <form id="formLogin" asp-controller="Home" asp-action="Login" method="post">
                                <div class="form-floating mb-4">
                                    <input type="email" id="CorreoElectronico" name="CorreoElectronico" class="form-control" asp-for="CorreoElectronico"
                                        placeholder="Correo Electrónico" required />
                                    <label for="Contrasenna">CorreoElectronico</label>
                                </div>
                                <div class="form-floating mb-4">
                                    <input type="password" id="Contrasenna" name="Contrasenna" class="form-control" asp-for="Contrasenna" placeholder="Contraseña" required />
                                    <label for="Contrasenna">Contraseña</label>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="" id="rememberMe" />
                                        <label class="form-check-label" for="rememberMe">
                                            Recordarme
                                        </label>
                                    </div>
                                    <a asp-action="RecuperarAcceso" asp-controller="Home" class="text-decoration-none">¿Olvidaste tu contraseña?</a>
                                </div>
                            
                                <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">
                                    <iconify-icon icon="mdi:login" class="me-2"></iconify-icon>
                                        Ingresar
                                </button>
                                
                                <div class="text-center">
                                    <p class="mb-0">
                                    ¿No tienes cuenta?
                                    <a asp-controller="Home" asp-action="Registro" class="fw-bold text-decoration-none">Regístrate aquí</a>
                                 </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script src="~/js/login.js" asp-append-version="true"></script>
}