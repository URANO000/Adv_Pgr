@model Usuario

@{
    ViewData["Title"] = "Registro";
    Layout = "_LayoutExterno";
}

<!-- Section: Design Block -->
<section class="text-center text-lg-start">
    <!-- Jumbotron -->
    <div class="login-section">
        <div class="container login-container m-5">
            <div class="row g-0 align-items-center">

                <div class="col-lg-6 mb-5 mb-lg-0">
                    <div class="card cascading-right bg-body-tertiary" style="backdrop-filter: blur(30px);">
                        <div class="card-body p-4 shadow-5 text-center">

                            <iconify-icon icon="mdi:account-plus" class="login-icon"></iconify-icon>
                            <h2 class="fw-bold mb-3">Crear cuenta</h2>
                            <p class="text-muted mb-4">Únete a nuestra comunidad de adopción responsable</p>

                            @if (ViewBag.Mensaje != null)
                            {
                                <div class="alert alert-danger text-center text-black">
                                    @ViewBag.Mensaje
                                </div>
                            }

                            <div class="formRegistro">
                                <form id="formRegistro" asp-controller="Home" asp-action="Registro" method="post">

                                    <div class="form-floating mb-4">
                                        <input type="text" id="Cedula" name="Cedula"
                                               class="form-control" asp-for="Cedula"
                                               placeholder="Identificación" onkeyup="ConsultarNombre();" required="" />
                                        <label for="Cedula">Cédula</label>
                                    </div>

                                   <div class="row">
                                        <div class="form-floating mb-4 col-md-6 ">
                                            <input type="text" id="PrimerNombre" name="PrimerNombre"
                                                   class="form-control ReadOnly" readonly="readonly" asp-for="PrimerNombre"
                                                   placeholder="Primer Nombre" required="" />
                                            <label for="PrimerNombre">Primer Nombre</label>
                                        </div>
                                        <div class="form-floating mb-4 col-md-6 ">
                                            <input type="text" id="SegundoNombre" name="SegundoNombre"
                                                   class="form-control ReadOnly" readonly="readonly" asp-for="SegundoNombre"
                                                   placeholder="Segundo Nombre" />
                                            <label for="SegundoNombre">Segundo Nombre</label>
                                        </div>
                                   </div>
                                    <div class="row">
                                        <div class="form-floating mb-4 col-md-6 ">
                                            <input type="text" id="PrimerApellido" name="PrimerApellido"
                                                   class="form-control ReadOnly" readonly="readonly" asp-for="PrimerApellido"
                                                   placeholder="Primer Apellido" required="" />
                                            <label for="PrimerApellido">Primer Apellido</label>
                                        </div>
                                        <div class="form-floating mb-4 col-md-6 ">
                                            <input type="text" id="SegundoApellido" name="SegundoApellido"
                                                   class="form-control ReadOnly" readonly="readonly" asp-for="SegundoApellido"
                                                   placeholder="Segundo Apellido" />
                                            <label for="SegundoApellido">Segundo Apellido</label>
                                        </div>
                                    </div>

                                    <div class="row">
                                        <div class="form-floating mb-4 col-md-6 ">
                                            <input type="tel" id="Telefono" name="Telefono"
                                                   class="form-control" asp-for="Telefono"
                                                   placeholder="Teléfono" />
                                            <label for="Telefono">Teléfono</label>
                                        </div>

                                        <div class="form-floating mb-4 col-md-6 ">
                                            <select id="Provincia" name="Provincia" class="form-select" asp-for="Provincia">
                                                <option value="">Seleccione...</option>
                                                <option value="San José">San José</option>
                                                <option value="Alajuela">Alajuela</option>
                                                <option value="Cartago">Cartago</option>
                                                <option value="Heredia">Heredia</option>
                                                <option value="Guanacaste">Guanacaste</option>
                                                <option value="Puntarenas">Puntarenas</option>
                                                <option value="Limón">Limón</option>
                                            </select>
                                            <label for="Provincia">Provincia</label>
                                        </div>
                                    </div>

                                    <div class="form-floating mb-4">
                                        <input type="email" id="CorreoElectronico" name="CorreoElectronico"
                                               class="form-control" asp-for="CorreoElectronico"
                                               placeholder="Correo Electrónico" required="" />
                                        <label for="CorreoElectronico">Correo Electrónico</label>
                                    </div>

                                    <div class="form-floating mb-4">
                                        <input type="password" id="Contrasenna" name="Contrasenna"
                                               class="form-control" asp-for="Contrasenna"
                                               placeholder="Contraseña" required="" />
                                        <label for="Contrasenna">Contraseña</label>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-lg w-100 mb-4">
                                        <iconify-icon icon="mdi:account-check" class="me-2"></iconify-icon>
                                        Registrarse
                                    </button>

                                    <div class="text-center">
                                        <p class="mb-0">
                                            ¿Ya tienes cuenta?
                                            <a asp-controller="Home" asp-action="Login" class="fw-bold text-decoration-none">
                                                Inicia sesión
                                            </a>
                                        </p>
                                    </div>

                                </form>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="col-lg-6 mb-5 mb-lg-0">
                    <img src="~/img/registro.png" class="w-100 rounded-4 shadow-4" />
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script src="~/js/utilities.js" asp-append-version="true"></script>
    <script src="~/js/registro.js" asp-append-version="true"></script>
}