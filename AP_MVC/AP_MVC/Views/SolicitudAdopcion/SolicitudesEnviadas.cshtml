@model List<AP_MVC.Models.Adopciones.SolicitudEnviadaViewModel>

@{
    ViewData["Title"] = "Mis solicitudes enviadas";
}

<style>
    .solicitudes-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 2rem 1rem 3rem;
    }

    .solicitudes-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .solicitudes-title {
        font-weight: 800;
        color: #2c3e50;
        margin: 0;
    }

    .solicitudes-subtitle {
        color: #6c757d;
        margin: .25rem 0 0;
    }

    .solicitudes-card {
        border: 0;
        border-radius: 1rem;
        box-shadow: 0 8px 24px rgba(0,0,0,.08);
        overflow: hidden;
        background: #fff;
    }

    .solicitudes-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: .75rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #eee;
        background: #fafafa;
    }

    .solicitudes-filtros {
        display: flex;
        gap: .5rem;
        flex-wrap: wrap;
    }

        .solicitudes-filtros .btn {
            border-radius: 999px;
            font-weight: 600;
        }

    .active-filter {
        background-color: #0d6efd !important;
        color: #fff !important;
        border-color: #0d6efd !important;
    }

    .table thead th {
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
    }

    .estado-badge {
        padding: .45rem .8rem;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 700;
        display: inline-block;
    }

    .estado-pendiente {
        background-color: #fff3cd;
        color: #856404;
    }

    .estado-aprobada {
        background-color: #d1e7dd;
        color: #0f5132;
    }

    .estado-rechazada {
        background-color: #f8d7da;
        color: #842029;
    }

    .estado-revisar {
        background-color: #cff4fc;
        color: #055160;
    }

    .mensaje-box {
        max-width: 280px;
        white-space: normal;
        word-break: break-word;
    }
</style>

<div class="solicitudes-page">

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="solicitudes-header">
        <div>
            <h2 class="solicitudes-title">
                <iconify-icon icon="mdi:send-outline" class="me-2"></iconify-icon>
                Mis solicitudes enviadas
            </h2>
            <p class="solicitudes-subtitle">
                Consultá el estado y la información de las solicitudes de adopción que has enviado.
            </p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info shadow-sm border-0 rounded-4">
            <iconify-icon icon="mdi:information-outline" class="me-2"></iconify-icon>
            Aún no has enviado solicitudes de adopción.
        </div>
    }
    else
    {
        <div class="solicitudes-card">

            <div class="solicitudes-toolbar">
                <div class="solicitudes-filtros">
                    <button type="button" class="btn btn-outline-secondary active-filter" data-filtro="todas">
                        Todas
                    </button>
                    <button type="button" class="btn btn-outline-warning" data-filtro="pendiente">
                        Pendientes
                    </button>
                    <button type="button" class="btn btn-outline-info" data-filtro="revisar">
                        En revisión
                    </button>
                    <button type="button" class="btn btn-outline-success" data-filtro="aprobada">
                        Aprobadas
                    </button>
                    <button type="button" class="btn btn-outline-danger" data-filtro="rechazada">
                        Rechazadas
                    </button>
                </div>

                <span id="contadorSolicitudes" class="text-muted fw-semibold">
                    @Model.Count solicitud(es)
                </span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Publicación</th>
                            <th>Mascota</th>
                            <th>Mensaje</th>
                            <th>Estado</th>
                            <th>Fecha de envío</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model)
                        {
                            var estadoClase = s.Estado switch
                            {
                                "Pendiente" => "estado-pendiente",
                                "Aprobada" => "estado-aprobada",
                                "Rechazada" => "estado-rechazada",
                                "Revisar" => "estado-revisar",
                                _ => "estado-pendiente"
                            };

                            var estadoFiltro = s.Estado.ToLower();

                            <tr class="fila-solicitud" data-estado="@estadoFiltro">
                                <td>
                                    <div class="fw-semibold">@s.Titulo</div>
                                </td>
                                <td>@s.NombreMascota</td>
                                <td>
                                    <div class="mensaje-box text-muted">
                                        @s.Mensaje
                                    </div>
                                </td>
                                <td>
                                    <span class="estado-badge @estadoClase">
                                        @s.Estado
                                    </span>
                                </td>
                                <td>@s.SentAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    <a asp-controller="Mascota"
                                           asp-action="DetalleCatalogo"
                                           asp-route-publicacionId="@s.PublicacionId"
                                           class="btn btn-sm btn-outline-primary rounded-pill">
                                        <iconify-icon icon="mdi:eye-outline"></iconify-icon>
                                        Ver publicación
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div id="sinResultados" class="text-center py-4 d-none">
            <iconify-icon icon="mdi:magnify-close" style="font-size:3rem;color:#ccc;"></iconify-icon>
            <p class="text-muted mt-2">No hay solicitudes con ese estado.</p>
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/solicitudes-enviadas.js"></script>
}