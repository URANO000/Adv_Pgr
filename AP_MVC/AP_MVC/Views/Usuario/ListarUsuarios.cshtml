@model List<Usuario>
@{
    ViewData["Title"] = "Listado de Usuarios";
}

<section class="container-fluid py-3">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            <div class="card shadow-sm">
                <div class="card-body p-3">

                    <!-- Header -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Usuarios</h5>

                        <!-- Buscador futuro.... -->
                        <input type="text" class="form-control w-auto" placeholder="Buscar..." />
                    </div>

                    <!-- Table -->
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">

                            <thead class="table-light">
                                <tr>
                                    <th>Acciones</th>
                                    <th>Cédula</th>
                                    <th>Usuario</th>
                                    <th>Contacto</th>
                                    <th>Ubicación</th>
                                    <th>Estado</th>
                                    <th>Rol</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var u in Model)
                                {
                                    <tr>
                                        <td class="px-4">
                                            <a asp-action="Detalle" asp-controller="Usuario" asp-route-usuarioId="@u.UsuarioId">
                                                <iconify-icon icon="mdi:eye-outline" class="text-center" style="color:green">
                                                </iconify-icon>
                                            </a>
                                        </td>
                                        <!-- Cedula -->
                                        <td class="fw-semibold">@u.Cedula</td>

                                        <!-- Nombre + Fecha -->
                                        <td>
                                            <div class="fw-semibold">@u.nombreCompleto</div>
                                            <small class="text-muted">
                                                @u.CreatedAt.ToString("dd/MM/yyyy")
                                            </small>
                                        </td>

                                        <!-- Contacto agrupado -->
                                        <td>
                                            <div>@u.CorreoElectronico</div>
                                            <small class="text-muted">@u.Telefono</small>
                                        </td>

                                        <!-- Provincia -->
                                        <td>@u.Provincia</td>

                                        <!-- Estado -->
                                        <td>
                                            @if (u.IsActive)
                                            {
                                                <span class="badge bg-success text-black">Activo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-black">Inactivo</span>
                                            }
                                        </td>

                                        <!-- Rol -->
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary">
                                                @u.RolId
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>