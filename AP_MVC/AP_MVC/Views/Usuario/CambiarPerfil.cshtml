@model Usuario

@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "_Layout";

    var imagenPerfil = string.IsNullOrEmpty(Model.ImagenPerfil) ? "/uploads/default.jpg" : Model.ImagenPerfil;

}

<section class="text-center text-lg-start mb-3">
    <div class="perfil-section">
        <div class="container py-3">
            <div class="row justify-content-center">

                <div class="col-lg-8 col-md-11">
                    <div class="card bg-body-tertiary shadow-sm">
                        <div class="card-body p-3 shadow-5 text-center perfil-card">
                            <iconify-icon icon="mdi:paw" class="login-icon" style="font-size: 28px;"></iconify-icon>
                            <h4 class="fw-bold mb-2">Editar Perfil</h4>

                            @if (ViewBag.Mensaje != null)
                            {
                                <div class="alert alert-info text-black">
                                    @ViewBag.Mensaje
                                </div>
                            }

                            <form asp-action="CambiarPerfil" asp-controller="Usuario" method="post" enctype="multipart/form-data">

                                <!-- Imagen actual -->
                                <div class="mb-4">
                                    <img src="@imagenPerfil"
                                         class="rounded-circle mb-2"
                                         width="90" height="90"
                                         style="object-fit: cover;" />

                                    <input type="file" name="ImagenPerfil" class="form-control" />
                                </div>
                                <!-- Correo -->
                                <div class="form-floating mb-2">
                                    <input asp-for="CorreoElectronico" class="form-control" />
                                    <label>Correo Electrónico</label>
                                </div>

                                <div class="mb-3">
                                    <div class="form-floating">
                                        <input asp-for="Cedula" class="form-control" onkeyup="ConsultarNombre();" />
                                        <label>Cédula</label>
                                    </div>
                                </div>

                                <!-- Nombres -->
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <div class="form-floating">
                                            <input asp-for="PrimerNombre" class="form-control" readonly="readonly" />
                                            <label>Primer Nombre</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-2">
                                        <div class="form-floating">
                                            <input asp-for="SegundoNombre" class="form-control" readonly="readonly" />
                                            <label>Segundo Nombre</label>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <div class="form-floating">
                                            <input asp-for="PrimerApellido" class="form-control" readonly="readonly" />
                                            <label>Primer Apellido</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6 mb-2">
                                        <div class="form-floating">
                                            <input asp-for="SegundoApellido" class="form-control" readonly="readonly" />
                                            <label>Segundo Apellido</label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Contacto -->
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        <div class="form-floating">
                                            <input asp-for="Telefono" class="form-control" />
                                            <label>Teléfono</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        <div class="form-floating">
                                            <select asp-for="Provincia" class="form-select">
                                                <option value="">Seleccione...</option>
                                                <option>San José</option>
                                                <option>Alajuela</option>
                                                <option>Cartago</option>
                                                <option>Heredia</option>
                                                <option>Guanacaste</option>
                                                <option>Puntarenas</option>
                                                <option>Limón</option>
                                            </select>
                                            <label>Provincia</label>
                                        </div>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-primary w-100">
                                    Guardar Cambios
                                </button>

                            </form>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts{
    <script src="~/js/utilities.js" asp-append-version="true"></script>
}