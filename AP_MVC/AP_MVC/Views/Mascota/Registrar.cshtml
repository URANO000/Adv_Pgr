@model AP_MVC.Models.Mascotas.MascotaPublicacionCrearViewModel

@{
    ViewData["Title"] = "Registrar mascota";
}

<section class="mascota-page-section">
    <div class="container py-5">
        <div class="row align-items-start g-4">

            <div class="col-lg-5">
                <div class="mascota-side-panel">
                    <span class="mascota-badge">Nueva publicación</span>
                    <h1 class="mascota-title">Registrar mascota en adopción</h1>
                    <p class="mascota-subtitle">
                        Publica una mascota con toda su información para que otras personas puedan conocerla
                        y encontrarle un hogar responsable.
                    </p>

                    <div class="mascota-side-card">
                        <h5>¿Qué puedes registrar aquí?</h5>
                        <ul class="mascota-checklist">
                            <li>Información general de la mascota</li>
                            <li>Detalles médicos y alimenticios</li>
                            <li>Título y descripción de la publicación</li>
                            <li>Luego podrás asociar imágenes</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card mascota-form-card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-2">Formulario de publicación</h2>
                            <p class="text-muted mb-0">
                                Completa los datos de la mascota y de la publicación.
                            </p>
                        </div>

                        @if (ViewBag.Mensaje != null)
                        {
                            <div class="alert alert-danger text-center">
                                @ViewBag.Mensaje
                            </div>
                        }

                        <form asp-action="Registrar" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <div class="mascota-form-section">
                                <div class="section-header">
                                    <h4>Datos de la mascota</h4>
                                    <p>Información básica para identificar a la mascota.</p>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <select asp-for="TipoId" asp-items="ViewBag.TiposAnimal" class="form-select">
                                                <option value="">Seleccione...</option>
                                            </select>
                                            <label asp-for="TipoId">Tipo de animal</label>
                                        </div>
                                        <span asp-validation-for="TipoId" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                                            <label asp-for="Nombre">Nombre</label>
                                        </div>
                                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="Peso" class="form-label">Peso (kg)</label>
                                        <input asp-for="Peso"
                                               type="number"
                                               step="0.1"
                                               min="0.1"
                                               class="form-control"
                                               placeholder="Ej. 1.5" />
                                        <span asp-validation-for="Peso" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="EdadValor" class="form-label">Edad</label>
                                        <input asp-for="EdadValor"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="Ej. 2" />
                                        <span asp-validation-for="EdadValor" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="EdadUnidad" class="form-label">Unidad de edad</label>
                                        <select asp-for="EdadUnidad" class="form-select">
                                            <option value="">Seleccione...</option>
                                            <option value="Meses">Meses</option>
                                            <option value="Años">Años</option>
                                        </select>
                                        <span asp-validation-for="EdadUnidad" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <select asp-for="Sexo" class="form-select">
                                                <option value="">Seleccione...</option>
                                                <option value="M">Macho</option>
                                                <option value="H">Hembra</option>
                                            </select>
                                            <label asp-for="Sexo">Sexo</label>
                                        </div>
                                        <span asp-validation-for="Sexo" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Enfermedades" class="form-control" placeholder="Enfermedades" />
                                            <label asp-for="Enfermedades">Enfermedades</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea asp-for="HistorialMedico" class="form-control mascota-textarea" placeholder="Historial médico"></textarea>
                                            <label asp-for="HistorialMedico">Historial médico</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea asp-for="PreferenciasAlimenticias" class="form-control mascota-textarea" placeholder="Preferencias alimenticias"></textarea>
                                            <label asp-for="PreferenciasAlimenticias">Preferencias alimenticias</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea asp-for="Notas" class="form-control mascota-textarea" placeholder="Notas"></textarea>
                                            <label asp-for="Notas">Notas</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mascota-form-section mt-4">
                                <div class="section-header">
                                    <h4>Datos de la publicación</h4>
                                    <p>Esto será lo que vea la persona interesada.</p>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Titulo" class="form-control" placeholder="Título" />
                                            <label asp-for="Titulo">Título</label>
                                        </div>
                                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea asp-for="Descripcion" class="form-control mascota-textarea-lg" placeholder="Descripción"></textarea>
                                            <label asp-for="Descripcion">Descripción</label>
                                        </div>
                                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="mascota-form-section mt-4">
                                <div class="section-header">
                                    <h4>Imágenes de la mascota</h4>
                                    <p>Selecciona una o varias imágenes para que la publicación se vea más atractiva.</p>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <label for="ImagenesArchivos" class="form-label">Agrega las imágenes de la mascota</label>
                                        <input type="file"
                                               id="ImagenesArchivos"
                                               name="ImagenesArchivos"
                                               class="form-control"
                                               multiple
                                               accept=".jpg,.jpeg,.png,.webp" />

                                        <small class="text-muted">
                                            Puedes agregar varias imágenes, quitarlas individualmente y volver a añadir más antes de guardar.
                                        </small>
                                    </div>

                                    <div class="col-12">
                                        <div id="previewVacio" class="mascota-preview-empty">
                                            <div class="mascota-preview-empty-icon">📷</div>
                                            <p class="mb-0">Aquí se mostrarán las imágenes seleccionadas.</p>
                                        </div>

                                        <div id="previewGrid" class="mascota-preview-grid d-none"></div>

                                        <div id="previewContador" class="mascota-preview-counter mt-2 d-none"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-md-row gap-3 mt-4">
                                <button type="submit" class="btn btn-primary mascota-submit-btn">
                                    Guardar publicación
                                </button>

                                <a asp-action="MisPublicaciones" class="btn btn-outline-primary mascota-secondary-btn">
                                    Ver mis publicaciones
                                </a>
                            </div>
                        </form>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/registrar-mascota.js"></script>
}