@model AP_MVC.Models.Mascotas.MascotaPublicacionCrearViewModel

@{
    ViewData["Title"] = "Registrar mascota";
}

<section class="mascota-page-section">
    <div class="container-fluid mascota-register-container py-4 py-lg-5">

        <div class="mascota-register-header mb-4">
            <div class="row g-3 align-items-center">
                <div class="col-lg-8">
                    <span class="mascota-badge">Nueva publicación</span>
                    <h1 class="mascota-title mb-2">Registrar mascota en adopción</h1>
                    <p class="mascota-subtitle mb-0">
                        Publica una mascota con toda su información para que otras personas puedan conocerla
                        y encontrarle un hogar responsable.
                    </p>
                </div>
                <div class="col-lg-4">
                    <div class="mascota-top-help-card">
                        <h5 class="mb-2">¿Qué registrarás aquí?</h5>
                        <ul class="mascota-checklist compact-list mb-0">
                            <li>Información general</li>
                            <li>Datos médicos y alimenticios</li>
                            <li>Título y descripción</li>
                            <li>Imágenes de la publicación</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger text-center mb-4">
                @ViewBag.Mensaje
            </div>
        }

        <div class="card mascota-form-card mascota-form-card-wide shadow-sm border-0">
            <div class="card-body p-3 p-md-4 p-xl-4">

                <div class="mascota-form-topbar mb-4">
                    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
                        <div>
                            <span class="mascota-section-kicker">Panel de registro</span>
                            <h2 class="fw-bold mb-1">Nueva publicación de adopción</h2>
                            <p class="text-muted mb-0">
                                Completa todos los campos y organiza la publicación de forma más clara y compacta.
                            </p>
                        </div>

                        <div class="mascota-inline-tips">
                            <span class="tip-chip">Menos scroll</span>
                            <span class="tip-chip">Campos agrupados</span>
                            <span class="tip-chip">Diseño más limpio</span>
                        </div>
                    </div>
                </div>

                <form asp-action="Registrar" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <!-- FILA 1 -->
                    <div class="row g-4">
                        <!-- DATOS GENERALES -->
                        <div class="col-xl-7">
                            <div class="mascota-form-section mascota-section-compact h-100">
                                <div class="section-header section-header-inline">
                                    <div>
                                        <h4>Datos generales</h4>
                                        <p>Información básica para identificar a la mascota.</p>
                                    </div>
                                    <span class="mascota-section-pill">Paso 1</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <select asp-for="TipoId" asp-items="ViewBag.TiposAnimal" class="form-select">
                                                <option value="">Seleccione...</option>
                                            </select>
                                            <label asp-for="TipoId">Tipo de animal</label>
                                        </div>
                                        <span asp-validation-for="TipoId" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                                            <label asp-for="Nombre">Nombre</label>
                                        </div>
                                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <select asp-for="Sexo" class="form-select">
                                                <option value="">Seleccione...</option>
                                                <option value="M">Macho</option>
                                                <option value="H">Hembra</option>
                                            </select>
                                            <label asp-for="Sexo">Sexo</label>
                                        </div>
                                        <span asp-validation-for="Sexo" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <input asp-for="Peso"
                                                   type="number"
                                                   step="0.1"
                                                   min="0.1"
                                                   class="form-control"
                                                   placeholder="Ej. 1.5" />
                                            <label asp-for="Peso">Peso (kg)</label>
                                        </div>
                                        <span asp-validation-for="Peso" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <input asp-for="EdadValor"
                                                   type="number"
                                                   min="0"
                                                   class="form-control"
                                                   placeholder="Ej. 2" />
                                            <label asp-for="EdadValor">Edad</label>
                                        </div>
                                        <span asp-validation-for="EdadValor" class="text-danger small"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <div class="form-floating">
                                            <select asp-for="EdadUnidad" class="form-select">
                                                <option value="">Seleccione...</option>
                                                <option value="Meses">Meses</option>
                                                <option value="Años">Años</option>
                                            </select>
                                            <label asp-for="EdadUnidad">Unidad de edad</label>
                                        </div>
                                        <span asp-validation-for="EdadUnidad" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- PUBLICACIÓN -->
                        <div class="col-xl-5">
                            <div class="mascota-form-section mascota-section-compact h-100">
                                <div class="section-header section-header-inline">
                                    <div>
                                        <h4>Publicación</h4>
                                        <p>Lo primero que verá la persona interesada.</p>
                                    </div>
                                    <span class="mascota-section-pill">Paso 2</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input asp-for="Titulo" class="form-control" placeholder="Título" />
                                            <label asp-for="Titulo">Título</label>
                                        </div>
                                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea asp-for="Descripcion"
                                                      class="form-control mascota-textarea-lg compact-description"
                                                      placeholder="Descripción"></textarea>
                                            <label asp-for="Descripcion">Descripción</label>
                                        </div>
                                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- FILA 2 -->
                    <div class="row g-4 mt-1">
                        <!-- SALUD -->
                        <div class="col-xl-8">
                            <div class="mascota-form-section mascota-section-compact h-100">
                                <div class="section-header section-header-inline">
                                    <div>
                                        <h4>Salud y cuidados</h4>
                                        <p>Resume el estado general en una distribución más horizontal.</p>
                                    </div>
                                    <span class="mascota-section-pill">Paso 3</span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input asp-for="Enfermedades" class="form-control" placeholder="Enfermedades" />
                                            <label asp-for="Enfermedades">Enfermedades</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <textarea asp-for="HistorialMedico"
                                                      class="form-control mascota-textarea-sm"
                                                      placeholder="Historial médico"></textarea>
                                            <label asp-for="HistorialMedico">Historial médico</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <textarea asp-for="PreferenciasAlimenticias"
                                                      class="form-control mascota-textarea-sm"
                                                      placeholder="Preferencias alimenticias"></textarea>
                                            <label asp-for="PreferenciasAlimenticias">Preferencias alimenticias</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <textarea asp-for="Notas"
                                                      class="form-control mascota-textarea-sm"
                                                      placeholder="Notas"></textarea>
                                            <label asp-for="Notas">Notas</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- IMÁGENES -->
                        <div class="col-xl-4">
                            <div class="mascota-form-section mascota-section-compact h-100">
                                <div class="section-header section-header-inline">
                                    <div>
                                        <h4>Imágenes</h4>
                                        <p>Sube fotos sin perder espacio vertical innecesario.</p>
                                    </div>
                                    <span class="mascota-section-pill">Paso 4</span>
                                </div>

                                <div class="mascota-upload-panel h-100">
                                    <label for="ImagenesArchivos" class="form-label fw-semibold mb-2">
                                        Agrega las imágenes
                                    </label>

                                    <input type="file"
                                           id="ImagenesArchivos"
                                           name="ImagenesArchivos"
                                           class="form-control"
                                           multiple
                                           accept=".jpg,.jpeg,.png,.webp" />

                                    <small class="text-muted d-block mt-2">
                                        Puedes agregar varias imágenes y eliminarlas antes de guardar.
                                    </small>

                                    <div class="mt-3">
                                        <div id="previewVacio" class="mascota-preview-empty compact-preview">
                                            <div class="mascota-preview-empty-icon">📷</div>
                                            <p class="mb-0">Aquí se mostrarán las imágenes seleccionadas.</p>
                                        </div>

                                        <div id="previewGrid" class="mascota-preview-grid d-none"></div>

                                        <div id="previewContador" class="mascota-preview-counter mt-2 d-none"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ACCIONES -->
                    <div class="mascota-form-actions mt-4">
                        <div class="d-flex flex-column flex-md-row gap-3">
                            <button type="submit" class="btn btn-primary mascota-submit-btn">
                                Guardar publicación
                            </button>

                            <a asp-action="MisPublicaciones" class="btn btn-outline-primary mascota-secondary-btn">
                                Ver mis publicaciones
                            </a>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/registrar-mascota.js"></script>
}