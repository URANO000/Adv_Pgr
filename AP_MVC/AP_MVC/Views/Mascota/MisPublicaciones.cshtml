@model List<AP_MVC.Models.Mascotas.MascotaPublicacionViewModel>

@{
    ViewData["Title"] = "Mis publicaciones";
}

<div class="container mt-4 mb-5">

    <div class="mispub-header">
        <div>
            <h2 class="mispub-title">Mis publicaciones</h2>
            <p class="mispub-subtitle">Aquí puedes ver las publicaciones que has registrado.</p>
        </div>

        <a asp-controller="Mascota"
               asp-action="Registrar"
               class="mispub-main-btn">
            Registrar nueva publicación
        </a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ViewBag.Mensaje))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @ViewBag.Mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="mispub-grid">

            @foreach (var item in Model)
            {
                var descripcionCorta = item.Descripcion;

                if (!string.IsNullOrWhiteSpace(descripcionCorta) && descripcionCorta.Length > 85)
                {
                    descripcionCorta = descripcionCorta.Substring(0, 85) + "...";
                }

                <div class="mispub-card">

                    <div class="mispub-card-image">
                        <img src="@item.ImagenUrl" />
                    </div>

                    <div class="mispub-card-content">

                        <h3 class="mispub-card-title">
                            @item.Titulo
                        </h3>

                        <p class="mispub-card-description">
                            @descripcionCorta
                        </p>

                        <div class="mispub-card-actions d-flex gap-2">
                            <a asp-controller="Mascota"
                                   asp-action="Detalle"
                                   asp-route-id="@item.PublicacionId"
                                   class="mispub-btn-info">
                                <iconify-icon icon="mdi:eye-outline" class="me-1"></iconify-icon>
                                Ver info
                            </a>
                            <a asp-controller="SolicitudAdopcion"
                                   asp-action="SolicitudesRecibidas"
                                   asp-route-publicacionId="@item.PublicacionId"
                                   class="mispub-btn-secondary">
                                <iconify-icon icon="mdi:inbox-outline" class="me-1"></iconify-icon>
                                Solicitudes
                            </a>
                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>