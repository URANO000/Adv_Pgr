@model AP_MVC.Models.Mascotas.MascotaDetalleViewModel

@{
    ViewData["Title"] = "Detalle de publicación";
    var usuarioSesionId = Context.Session.GetString("UsuarioId");
    var estaLogueado = !string.IsNullOrWhiteSpace(usuarioSesionId);
    var esPropietario = estaLogueado && usuarioSesionId == Model.UsuarioId;
    var esVistaPublica = ViewContext.RouteData.Values["action"]?.ToString() == "DetalleCatalogo";
}

<div class="container mt-4 mb-5">
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="detalle-publicacion-card">

        @if (Model.Imagenes != null && Model.Imagenes.Any())
        {
            <div id="detalleCarousel" class="carousel slide detalle-carousel" data-bs-ride="false">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Imagenes.Count; i++)
                    {
                        var imagen = Model.Imagenes[i];

                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@imagen.ArchivoUrl"
                                 class="d-block w-100 detalle-carousel-img detalle-lightbox-trigger"
                                 alt="Imagen @(i + 1) de la mascota"
                                 data-index="@i" />
                        </div>
                    }
                </div>

                @if (Model.Imagenes.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#detalleCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>

                    <button class="carousel-control-next" type="button" data-bs-target="#detalleCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                        <span class="visually-hidden">Siguiente</span>
                    </button>
                }
            </div>

            @if (Model.Imagenes.Count > 1)
            {
                <div class="detalle-thumbnails">
                    @for (int i = 0; i < Model.Imagenes.Count; i++)
                    {
                        var imagen = Model.Imagenes[i];

                        <button type="button"
                                class="detalle-thumbnail-btn @(i == 0 ? "active-thumbnail" : "")"
                                data-bs-target="#detalleCarousel"
                                data-bs-slide-to="@i"
                                aria-label="Ir a imagen @(i + 1)">
                            <img src="@imagen.ArchivoUrl"
                                 alt="Miniatura @(i + 1)"
                                 class="detalle-thumbnail-img detalle-lightbox-trigger"
                                 data-index="@i" />
                        </button>
                    }
                </div>
            }
        }
        else
        {
            <div class="detalle-imagen-principal">
                <img src="~/img/no-image.png" alt="Imagen de la mascota" />
            </div>
        }

        <div class="detalle-contenido">
            <div class="detalle-encabezado">
                <h1 class="detalle-titulo">@Model.Titulo</h1>
            </div>

            <p class="detalle-descripcion">
                @Model.Descripcion
            </p>

            <div class="detalle-info-rapida">
                <div><strong>Nombre:</strong> @Model.NombreMascota</div>
                <div><strong>Tipo:</strong> @Model.TipoAnimal</div>
                <div><strong>Categoría:</strong> @Model.CategoriaAnimal</div>
                <div><strong>Edad:</strong> @Model.Edad</div>
                <div><strong>Sexo:</strong> @Model.Sexo</div>
                <div><strong>Peso:</strong> @(Model.Peso.HasValue? Model.Peso.Value.ToString("0.##") + " kg" : "No registrado")</div>
            </div>

            <div class="detalle-info-extra">
                <p><strong>Enfermedades:</strong> @(string.IsNullOrWhiteSpace(Model.Enfermedades) ? "No registradas" : Model.Enfermedades)</p>
                <p><strong>Historial médico:</strong> @(string.IsNullOrWhiteSpace(Model.HistorialMedico) ? "No registrado" : Model.HistorialMedico)</p>
                <p><strong>Preferencias alimenticias:</strong> @(string.IsNullOrWhiteSpace(Model.PreferenciasAlimenticias) ? "No registradas" : Model.PreferenciasAlimenticias)</p>
                <p><strong>Notas:</strong> @(string.IsNullOrWhiteSpace(Model.Notas) ? "Sin notas" : Model.Notas)</p>
                <p><strong>Fecha de publicación:</strong> @Model.PublishedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>

            @if (Model.IsActive && esVistaPublica)
            {
                @if (!estaLogueado)
                {
                    <div class="card border-0 shadow-sm mt-4">
                        <div class="card-body">
                            <h5 class="mb-2">¿Te interesa adoptar a @Model.NombreMascota?</h5>
                            <p class="text-muted mb-3">
                                Inicia sesión para enviar una solicitud de adopción al propietario.
                            </p>
                            <a asp-controller="Home"
                                   asp-action="Login"
                                   class="btn btn-primary">
                                Iniciar sesión
                            </a>
                        </div>
                    </div>
                }
                else if (!esPropietario)
                {
                    <div class="solicitud-adopcion-cta mt-4">
                        <div>
                            <h5 class="mb-1">¿Te interesa adoptar a @Model.NombreMascota?</h5>
                            <p class="text-muted mb-0">
                                Contacta al propietario para iniciar el proceso de adopción.
                            </p>
                        </div>

                        <button type="button"
                                class="btn btn-success"
                                data-bs-toggle="modal"
                                data-bs-target="#modalSolicitudAdopcion">
                            Contactar
                        </button>
                    </div>
                }
            }

            @if (!esVistaPublica)
            {
                <div class="detalle-acciones">
                    <a asp-controller="Mascota"
                           asp-action="MisPublicaciones"
                           class="btn btn-secondary detalle-btn">
                        Volver
                    </a>

                    @if (Model.IsActive)
                    {
                        <a asp-controller="Mascota"
                               asp-action="Editar"
                               asp-route-id="@Model.PublicacionId"
                               class="btn btn-primary detalle-btn">
                            Editar
                        </a>

                        <button type="button"
                                class="btn btn-danger detalle-btn"
                                data-bs-toggle="modal"
                                data-bs-target="#modalEliminarPublicacion">
                            Eliminar publicación
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="detalle-acciones">
                    <a asp-controller="Mascota"
                           asp-action="Catalogo"
                           class="btn btn-secondary detalle-btn">
                        Volver al catálogo
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@if (Model.IsActive && esVistaPublica && estaLogueado && !esPropietario)
{
    var mensajeDefault = $"Estoy interesado en tu anuncio de adopción de PatitasSocial web, de {Model.NombreMascota}.";

    <div class="modal fade" id="modalSolicitudAdopcion" tabindex="-1" aria-labelledby="modalSolicitudAdopcionLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content custom-solicitud-modal">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title custom-solicitud-title" id="modalSolicitudAdopcionLabel">
                            Solicitar adopción
                        </h5>
                        <p class="text-muted mb-0 small">
                            Estás contactando al propietario de <strong>@Model.NombreMascota</strong>
                        </p>
                    </div>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <form asp-controller="Mascota"
                      asp-action="EnviarSolicitudAdopcion"
                      method="post">
                    <div class="modal-body pt-3">
                        @Html.AntiForgeryToken()

                        <input type="hidden" name="PublicacionId" value="@Model.PublicacionId" />

                        <div class="solicitud-contacto-box mb-3">
                            <div class="solicitud-contacto-item">
                                <label class="form-label mb-1">Nombre</label>
                                <input type="text"
                                       class="form-control"
                                       value="@Model.NombreUsuarioSesion"
                                       readonly />
                            </div>

                            <div class="solicitud-contacto-item">
                                <label class="form-label mb-1">Correo</label>
                                <input type="email"
                                       class="form-control"
                                       value="@Model.CorreoUsuarioSesion"
                                       readonly />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label for="Mensaje" class="form-label fw-semibold">
                                Mensaje
                            </label>
                            <textarea id="Mensaje"
                                      name="Mensaje"
                                      class="form-control"
                                      rows="5"
                                      maxlength="500"
                                      required>@mensajeDefault</textarea>
                            <div class="form-text">Puedes editar este mensaje antes de enviarlo.</div>
                        </div>
                    </div>

                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light custom-cancel-btn" data-bs-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="submit" class="btn btn-success">
                            Enviar solicitud
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (Model.Imagenes != null && Model.Imagenes.Any())
{
    <div id="detalleLightbox" class="detalle-lightbox d-none">
        <button type="button" id="detalleLightboxCerrar" class="detalle-lightbox-close" aria-label="Cerrar imagen">
            <span class="detalle-lightbox-icon detalle-lightbox-icon-close">&times;</span>
        </button>

        <button type="button" id="detalleLightboxPrev" class="detalle-lightbox-nav detalle-lightbox-prev" aria-label="Imagen anterior">
            <span class="detalle-lightbox-icon detalle-lightbox-icon-prev">&#8249;</span>
        </button>

        <div class="detalle-lightbox-content">
            <img id="detalleLightboxImg"
                 src=""
                 alt="Vista completa de imagen"
                 class="detalle-lightbox-image" />
        </div>

        <button type="button" id="detalleLightboxNext" class="detalle-lightbox-nav detalle-lightbox-next" aria-label="Imagen siguiente">
            <span class="detalle-lightbox-icon detalle-lightbox-icon-next">&#8250;</span>
        </button>
    </div>

    <script>
        window.detalleImagenes = [
            @Html.Raw(string.Join(",", Model.Imagenes.Select(i => $"'{i.ArchivoUrl}'")))
        ];
    </script>
}

@section Scripts {
    <script src="~/js/detalle-publicacion.js"></script>
    <script src="~/js/detalle-lightbox.js"></script>
}