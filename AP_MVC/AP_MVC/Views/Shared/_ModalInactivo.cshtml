@* Modal: Publicación inactiva *@

<div class="modal fade" id="modalInactivo" tabindex="-1" aria-labelledby="modalInactivoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-inactivar-content">

            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body text-center px-4 pb-2">
                <div class="modal-inactivar-icon mb-3">
                    <iconify-icon icon="mdi:lock-outline"></iconify-icon>
                </div>
                <h5 class="modal-inactivar-title">Publicación inactiva</h5>
                <p class="modal-inactivar-desc">
                    Esta publicación fue inactivada y no puede ser editada.
                </p>
            </div>

            <div class="modal-footer border-0 px-4 pb-4 justify-content-center">
                <button type="button" class="btn btn-outline-primary" data-bs-dismiss="modal">
                    <iconify-icon icon="mdi:close" class="me-1"></iconify-icon>Cerrar
                </button>
            </div>

        </div>
    </div>
</div>