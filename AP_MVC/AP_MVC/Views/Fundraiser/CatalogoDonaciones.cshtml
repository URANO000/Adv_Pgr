@model List<AP_MVC.Models.Fundraiser>

@{
    ViewData["Title"] = "Catálogo de Donaciones";
    Layout = "_Layout";
}

<section class="fundraiser-section">
    <div class="container fundraiser-container py-4">

        <!-- Header -->
        <div class="text-center mb-4">
            <iconify-icon icon="mdi:hand-heart" class="fundraiser-icon"></iconify-icon>
            <h2 class="fw-bold mb-1">Campañas de donación</h2>
            <p class="text-muted">Apoyá a las mascotas que más lo necesitan</p>
        </div>

        <!-- RF-021: Barra de búsqueda y filtros -->
        <div class="card shadow-sm mb-4 border-0">
            <div class="card-body py-3 px-4">
                <div class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label small text-muted mb-1">
                            <iconify-icon icon="mdi:magnify" class="me-1"></iconify-icon>Buscar campaña
                        </label>
                        <input type="text" id="inputBusqueda" class="form-control"
                               placeholder="Título o descripción..."
                               value="@ViewBag.Busqueda" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small text-muted mb-1">
                            <iconify-icon icon="mdi:filter-outline" class="me-1"></iconify-icon>Filtrar por animal
                        </label>
                        <input type="text" id="inputFiltroAnimal" class="form-control"
                               placeholder="Ej: Max, Luna..." />
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary w-100" id="btnLimpiarFiltros">
                            <iconify-icon icon="mdi:close-circle-outline" class="me-1"></iconify-icon>Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mensaje de éxito / error -->
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <iconify-icon icon="mdi:check-circle-outline" class="me-2"></iconify-icon>@TempData["Exito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <iconify-icon icon="mdi:alert-circle-outline" class="me-2"></iconify-icon>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Contador de resultados -->
        <p class="text-muted small mb-3" id="contadorResultados">
            @(Model?.Count ?? 0) campaña(s) encontrada(s)
        </p>

        <!-- Grid de cards -->
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <iconify-icon icon="mdi:heart-off-outline" style="font-size:4rem;color:#ccc;"></iconify-icon>
                <p class="text-muted mt-3">No hay campañas activas en este momento.</p>
                <a asp-controller="Fundraiser" asp-action="Registrar" class="btn btn-primary mt-2">
                    <iconify-icon icon="mdi:plus-circle-outline" class="me-1"></iconify-icon>Crear campaña
                </a>
            </div>
        }
        else
        {
            <div class="row g-4" id="gridFundraisers">
                @foreach (var item in Model)
                {
                    var porcentaje = item.MetaTotal > 0
                        ? Math.Min((double)(item.TotalActual / item.MetaTotal) * 100, 100)
                        : 0;

                    <div class="col-lg-4 col-md-6 fundraiser-card-item"
                         data-titulo="@item.Titulo.ToLower()"
                         data-descripcion="@item.Descripcion.ToLower()"
                         data-animal="@item.NombreAnimal.ToLower()">
                        <div class="card h-100 shadow-sm border-0 fundraiser-card">
                            <div class="card-body d-flex flex-column p-4">

                                <!-- Header de la card -->
                                <div class="d-flex align-items-center mb-3">
                                    <div class="fundraiser-avatar me-3">
                                        <iconify-icon icon="mdi:paw" style="font-size:1.6rem;color:#e67e22;"></iconify-icon>
                                    </div>
                                    <div>
                                        <h5 class="fw-bold mb-0 fundraiser-titulo">@item.Titulo</h5>
                                        <small class="text-muted">
                                            <iconify-icon icon="mdi:paw" class="me-1"></iconify-icon>@item.NombreAnimal
                                        </small>
                                    </div>
                                </div>

                                <!-- Descripción -->
                                <p class="text-muted small mb-3 flex-grow-1 fundraiser-descripcion">
                                    @(item.Descripcion.Length > 120
                                        ? item.Descripcion.Substring(0, 120) + "..."
                                        : item.Descripcion)
                                </p>

                                <!-- Barra de progreso -->
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted">Recaudado</span>
                                        <span class="fw-bold text-success">@porcentaje.ToString("0")%</span>
                                    </div>
                                    <div class="progress" style="height:8px;border-radius:10px;">
                                        <div class="progress-bar bg-success"
                                             role="progressbar"
                                             style="width:@porcentaje.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture)%"
                                             aria-valuenow="@porcentaje"
                                             aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-between small mt-1">
                                        <span class="text-muted">₡@item.TotalActual.ToString("N2") recaudados</span>
                                        <span class="text-muted">Meta: ₡@item.MetaTotal.ToString("N2")</span>
                                    </div>
                                </div>

                                <!-- Botón detalle -->
                                <a asp-controller="Fundraiser" asp-action="Detalle" asp-route-id="@item.FundraiserId"
                                   class="btn btn-primary w-100 mt-auto">
                                    <iconify-icon icon="mdi:eye-outline" class="me-1"></iconify-icon>Ver campaña
                                </a>

                            </div>
                            <div class="card-footer border-0 bg-transparent text-center pb-3">
                                <small class="text-muted">
                                    <iconify-icon icon="mdi:calendar-outline" class="me-1"></iconify-icon>
                                    Publicado: @item.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Mensaje sin resultados de filtro -->
            <div id="sinResultados" class="text-center py-4 d-none">
                <iconify-icon icon="mdi:magnify-close" style="font-size:3rem;color:#ccc;"></iconify-icon>
                <p class="text-muted mt-2">No se encontraron campañas con ese criterio.</p>
            </div>
        }

    </div>
</section>

@section Scripts {
    <script src="~/js/Fundraiser.js"></script>
}