@model AP_MVC.Models.Fundraiser

@{
    ViewData["Title"] = "Editar Publicación de Donación";
    Layout = "_Layout";
}

<div class="container mt-4 mb-5">
    <div class="editpub-card">
        <div class="editpub-header">
            <h2 class="editpub-title">Editar publicación de donación</h2>
            <p class="editpub-subtitle">Modificá los datos de tu campaña de donación.</p>
        </div>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-controller="Fundraiser" asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="FundraiserId" />
            <input type="hidden" asp-for="AnimalId" />
            <input type="hidden" asp-for="MetaTotal" />

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" maxlength="200" required />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="5" required></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="editpub-actions">
                <a asp-controller="Fundraiser" asp-action="Catalogo" class="btn btn-secondary editpub-btn d-inline-flex align-items-center justify-content-center">
                    Cancelar
                </a>

                <button type="submit" class="btn btn-primary editpub-btn">
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@await Html.PartialAsync("_ModalInactivo")

@section Scripts {
    <script src="~/js/Fundraiser.js"></script>
    @if (TempData["MostrarModalInactivo"] != null)
    {
        <script>var mostrarModalInactivo = true;</script>
    }
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}