@model AP_MVC.Models.Fundraiser
@using System.Globalization

@{
    ViewData["Title"] = "Detalle de Campaña";
    Layout = "_Layout";

    var donaciones = ViewBag.Donaciones as List<AP_MVC.Models.Donacion> ?? new List<AP_MVC.Models.Donacion>();
    bool estaLogueado = ViewBag.EstaLogueado ?? false;

    decimal porcentaje = Model.MetaTotal > 0
     ? ((Model.TotalActual / Model.MetaTotal) * 100 > 100
         ? 100
         : (Model.TotalActual / Model.MetaTotal) * 100)
     : 0;

    // Color barra
    string colorClase = "";
    if (porcentaje >= 75)
    {
        colorClase = "bg-info";
    }
    else if (porcentaje <= 75)
    {
        colorClase = "bg-danger";
    }
}

<section class="fundraiser-section">
    <div class="container fundraiser-container py-4">

        <!-- Alertas -->
        @if (TempData["DonacionExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <strong>¡Donación registrada!</strong> ₡@TempData["MontoDonado"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="row g-4">

            <!-- Columna principal -->
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 fundraiser-card">
                    <div class="card-body p-4 p-md-5">

                        <!-- Título -->
                        <h2 class="fw-bold">@Model.Titulo</h2>
                        <small class="text-muted">@Model.NombreAnimal</small>

                        <!-- Descripción -->
                        <p class="text-muted mt-3">@Model.Descripcion</p>

                        <!-- BARRA DE PROGRESO -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="fw-bold text-success fs-5">
                                    ₡@Model.TotalActual.ToString("N2")
                                </span>
                                <span class="text-muted">
                                    de ₡@Model.MetaTotal.ToString("N2")
                                </span>
                            </div>

                            <div class="progress mb-2" style="height:14px;border-radius:10px;">
                                <div class="progress-bar @colorClase progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     style="width:@(porcentaje.ToString("0.0", CultureInfo.InvariantCulture))%"
                                     aria-valuenow="@porcentaje"
                                     aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>

                            <div class="text-end">
                                <small class="text-muted fw-bold">
                                    @porcentaje.ToString("0.0")% alcanzado
                                </small>
                            </div>
                        </div>

                        <hr />

                        <!-- Donaciones -->
                        <h5 class="fw-bold mb-3">Donantes (@donaciones.Count)</h5>

                        @if (!donaciones.Any())
                        {
                            <p class="text-muted">Sé el primero en donar.</p>
                        }
                        else
                        {
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Donante</th>
                                        <th>Monto</th>
                                        <th>Fecha</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in donaciones)
                                    {
                                        <tr>
                                            <td>@d.NombreDonante</td>
                                            <td class="text-success fw-bold">₡@d.Total.ToString("N2")</td>
                                            <td>@d.DonatedAt.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                    </div>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 p-4 text-center">

                    <h5 class="fw-bold">Donar</h5>

                    <div class="mb-3">
                        <span class="fs-4 fw-bold text-success">
                            ₡@Model.TotalActual.ToString("N2")
                        </span>
                    </div>

                    @if (Model.IsActive)
                    {
                        <button class="btn btn-primary w-100">
                            Donar ahora
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-secondary small">
                            Campaña inactiva
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/Fundraiser.js"></script>
}