@model AP_MVC.Models.Fundraiser

@{
    ViewData["Title"] = "Registrar Publicación de Donación";
    Layout = "_Layout";
}

<section class="mascota-page-section">
    <div class="container py-5">
        <div class="row align-items-start g-4">

            <div class="col-lg-5">
                <div class="mascota-side-panel">
                    <span class="mascota-badge">Nueva publicación</span>
                    <h1 class="mascota-title">Registrar campaña de donación</h1>
                    <p class="mascota-subtitle">
                        Crea una campaña para recibir donaciones y ayudar a tu mascota.
                        Comparte su historia para que más personas puedan colaborar.
                    </p>

                    <div class="mascota-side-card">
                        <h5>¿Qué puedes registrar aquí?</h5>
                        <ul class="mascota-checklist">
                            <li>El animal al que va dirigida la campaña</li>
                            <li>Título y descripción de la situación</li>
                            <li>Meta de recaudación en colones</li>
                            <li>Estado inicial de la publicación</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card mascota-form-card shadow-sm border-0">
                    <div class="card-body p-4 p-md-5">

                        <div class="text-center mb-4">
                            <h2 class="fw-bold mb-2">Formulario de campaña</h2>
                            <p class="text-muted mb-0">
                                Completa los datos para crear tu publicación de donación.
                            </p>
                        </div>

                        <form asp-controller="Fundraiser" asp-action="Registrar" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mascota-form-section">
                                <div class="section-header">
                                    <h4>Datos de la campaña</h4>
                                    <p>Información principal de tu publicación de donación.</p>
                                </div>

                                <div class="row g-3">

                                    @if (ViewBag.Animales != null)
                                    {
                                        <div class="col-12">
                                            <div class="form-floating">
                                                <select id="AnimalId" name="AnimalId" class="form-select" asp-for="AnimalId"
                                                        asp-items="ViewBag.Animales" required>
                                                    <option value="">Seleccione un animal...</option>
                                                </select>
                                                <label for="AnimalId">Animal</label>
                                            </div>
                                            <span asp-validation-for="AnimalId" class="text-danger small"></span>
                                        </div>
                                    }

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input type="text" id="Titulo" name="Titulo"
                                                   class="form-control" asp-for="Titulo"
                                                   placeholder="Título de la publicación" maxlength="200" required />
                                            <label for="Titulo">Título</label>
                                        </div>
                                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea id="Descripcion" name="Descripcion"
                                                      class="form-control mascota-textarea-lg" asp-for="Descripcion"
                                                      placeholder="Descripción" required></textarea>
                                            <label for="Descripcion">Descripción</label>
                                        </div>
                                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input type="number" id="MetaTotal" name="MetaTotal"
                                                   class="form-control" asp-for="MetaTotal"
                                                   placeholder="Meta de recaudación (₡)" min="1" step="0.01" required />
                                            <label for="MetaTotal">Meta de recaudación (₡)</label>
                                        </div>
                                        <span asp-validation-for="MetaTotal" class="text-danger small"></span>
                                    </div>

                                </div>
                            </div>

                            <div class="d-flex flex-column flex-md-row gap-3 mt-4">
                                <button type="submit" class="btn btn-primary mascota-submit-btn">
                                    Publicar campaña
                                </button>

                                <a asp-controller="Fundraiser" asp-action="Catalogo" class="btn btn-outline-primary mascota-secondary-btn">
                                    Volver al catálogo
                                </a>
                            </div>

                        </form>

                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

@await Html.PartialAsync("_ModalInactivo")

@section Scripts {
    <script src="~/js/Fundraiser.js"></script>
    @if (TempData["MostrarModalInactivo"] != null)
    {
        <script>var mostrarModalInactivo = true;</script>
    }
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}