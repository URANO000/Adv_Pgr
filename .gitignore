## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
*.snupkg

# Others
~$*
*~
CodeCoverage/

# MSBuild Binary and Structured Log
*.binlog

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Visual Studio / archivos locales de IDE
.vs/
**/.vs/

# Archivos de usuario
*.suo
*.user
*.userosscache
*.sln.docstates

# Índices, cachés y metadatos de Visual Studio
*.vsidx
*.dbcache
*.opendb
*.VC.db
futdcache.v2
*.cache
DocumentLayout.json
DocumentLayout.backup.json

# Binarios/metadatos locales
*.bin
*.v10.bin
*.v2

# Secrets / configuración sensible
**/appsettings.Development.json
**/secrets.json

# Certificados / llaves
*.pfx
*.key
*.pem

# Uploads locales
**/wwwroot/uploads/*
!**/wwwroot/uploads/mascotas/
!**/wwwroot/uploads/mascotas/.gitkeep

# Variables de entorno locales
.env
.env.*
